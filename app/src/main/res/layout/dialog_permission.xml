<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="需要开启以下权限以确保工具正常运行："
        android:textSize="16sp"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔔 通知权限：用于在输入法被切换时及时通知您。"
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="start"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 允许后台弹出：用于在后台弹出通知横幅/锁屏提醒。"
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="start"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 获取输入法列表：用于检测所有已安装输入法。"
        android:textSize="14sp"
        android:textColor="#555555"
        android:gravity="start"
        android:layout_marginBottom="24dp"/>

    <!-- 第一行：通知和后台弹出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_permission_notification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="打开或关闭通知"
            android:maxLines="2"
            android:ellipsize="end"
            android:backgroundTint="#1A73E8"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_permission_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="打开或关闭后台弹出"
            android:maxLines="2"
            android:ellipsize="end"
            android:backgroundTint="#34A853"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- 第二行：获取输入法列表权限 和 返回 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_permission_query_packages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="获取输入法列表权限"
            android:maxLines="2"
            android:ellipsize="end"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btn_permission_return"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="返回"
            android:singleLine="true"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

</LinearLayout>