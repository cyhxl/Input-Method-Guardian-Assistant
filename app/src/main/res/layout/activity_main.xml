<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ 输入法守护助手"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1A73E8"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_selected_ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已选择的输入法：无"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_current_ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前输入法：未检测"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="12dp"/>

            <Button
                android:id="@+id/btn_select_ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择要保护的输入法"
                android:padding="14dp"
                android:backgroundTint="#1A73E8"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btn_switch_ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换输入法"
                android:padding="14dp"
                android:backgroundTint="#34A853"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btn_enable_ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启用输入法"
                android:padding="14dp"
                android:backgroundTint="#FF5722"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btn_notification_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打开通知权限"
                android:padding="14dp"
                android:backgroundTint="#FBBC04"
                android:textColor="#333333"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btn_view_tutorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看通知/切换教程"
                android:maxLines="2"
                android:padding="14dp"
                android:backgroundTint="#9C27B0"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"/>

            <!-- 新增：可识别守护的输入法按钮 -->
            <Button
                android:id="@+id/btn_recognizable_ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="可识别守护的输入法"
                android:padding="14dp"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF"
                android:layout_gravity="center"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/tv_notification_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通知权限状态：未知"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>